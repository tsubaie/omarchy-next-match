#!/usr/bin/env bash
# Look up an api-football team id by name.
#
#   scripts/find-team liverpool
#   scripts/find-team "real madrid"
#
# The key is taken from $API_FOOTBALL_KEY, or from the apiKey already set on the
# widget in ~/.config/omarchy/shell.json, or it is prompted for. It is never
# passed on a command line: curl reads the header from a config file on stdin,
# so it stays out of `ps` for every other user on the machine.
set -euo pipefail

query="${*:-}"
if [[ -z $query ]]; then
  echo "usage: $(basename "$0") <team name>" >&2
  exit 1
fi

key="${API_FOOTBALL_KEY:-}"

# Fall back to whatever the widget is already configured with, so a working
# setup does not have to hand the key over twice.
if [[ -z $key ]]; then
  config="$HOME/.config/omarchy/shell.json"
  if [[ -f $config ]] && command -v jq >/dev/null; then
    spec=$(jq -r '
      [.bar.layout.left[]?, .bar.layout.center[]?, .bar.layout.right[]?]
      | map(select(.id == "tsubaie.next-match"))
      | (.[0].apiKey // "")
    ' "$config" 2>/dev/null || true)
    case "$spec" in
      file:*) f="${spec#file:}"; key=$(cat -- "${f/#\~/$HOME}" 2>/dev/null || true) ;;
      env:*)  key="${!spec#env:}" ;;
      "")     ;;
      *)      key="$spec" ;;
    esac
  fi
fi

if [[ -z $key ]]; then
  read -rsp "api-football key: " key
  echo
fi

key=$(printf %s "$key" | tr -d '[:space:]')
[[ -n $key ]] || { echo "no API key" >&2; exit 1; }

url="https://v3.football.api-sports.io/teams?search=$(printf %s "$query" | jq -sRr @uri)"
response=$(printf 'header = "x-apisports-key: %s"\nurl = "%s"\n' "$key" "$url" | curl -fsS --max-time 20 -K -)

err=$(printf %s "$response" | jq -r '
  if (.errors | type) == "object" and (.errors | length) > 0
  then (.errors | to_entries[0].value) else "" end')
if [[ -n $err ]]; then
  echo "api-football: $err" >&2
  exit 1
fi

count=$(printf %s "$response" | jq -r '.results // 0')
if [[ $count == "0" ]]; then
  echo "No team matched \"$query\"." >&2
  exit 1
fi

printf '%-8s  %-32s  %-4s  %s\n' "ID" "TEAM" "CODE" "COUNTRY"
printf %s "$response" | jq -r '
  .response[]
  | [ (.team.id | tostring), .team.name, (.team.code // "-"), (.team.country // "-") ]
  | @tsv' | while IFS=$'\t' read -r id name code country; do
  printf '%-8s  %-32s  %-4s  %s\n' "$id" "$name" "$code" "$country"
done

echo
echo "Put the ID in the widget's \"Team ID\" setting."
