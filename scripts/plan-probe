#!/usr/bin/env bash
# Report what your api-football plan actually allows, so the widget can pick a
# query that works. Reads the key the same way the widget does and never puts
# it on a command line.
#
#   scripts/plan-probe [team-id]
set -uo pipefail

team="${1:-33}"
key="${API_FOOTBALL_KEY:-}"

if [[ -z $key ]]; then
  config="$HOME/.config/omarchy/shell.json"
  if [[ -f $config ]] && command -v jq >/dev/null; then
    spec=$(jq -r '
      [.bar.layout.left[]?, .bar.layout.center[]?, .bar.layout.right[]?]
      | map(select(.id == "tsubaie.next-match")) | (.[0].apiKey // "")' "$config" 2>/dev/null || true)
    case "$spec" in
      file:*) f="${spec#file:}"; key=$(cat -- "${f/#\~/$HOME}" 2>/dev/null || true) ;;
      env:*)  key="${!spec#env:}" ;;
      ""|null) ;;
      *)      key="$spec" ;;
    esac
  fi
fi
[[ -n $key ]] || { read -rsp 'api-football key: ' key; echo; }
key=$(printf %s "$key" | tr -d '[:space:]')
[[ -n $key ]] || { echo "no API key" >&2; exit 1; }

call() { printf 'header = "x-apisports-key: %s"\nurl = "%s"\n' "$key" "$1" | curl -fsS --max-time 25 -K -; }

base="https://v3.football.api-sports.io"
today=$(date -u +%F)
later=$(date -u -d "+120 days" +%F)
year=$(date -u +%Y)

report() { # label, json
  local label="$1" json="$2"
  local err results
  err=$(printf %s "$json" | jq -r 'if (.errors|type)=="object" and (.errors|length)>0 then (.errors|to_entries[0]|"\(.key): \(.value)") else "" end' 2>/dev/null)
  results=$(printf %s "$json" | jq -r '.results // 0' 2>/dev/null)
  if [[ -n $err ]]; then printf '  %-34s ERROR  %s\n' "$label" "$err"
  else printf '  %-34s ok     results=%s\n' "$label" "$results"; fi
}

echo "Account"
status=$(call "$base/status")
printf %s "$status" | jq -r '
  if (.errors|type)=="object" and (.errors|length)>0
  then "  key rejected: " + (.errors|to_entries[0].value)
  else "  plan: \(.response.subscription.plan)   ends: \(.response.subscription.end)\n  requests today: \(.response.requests.current)/\(.response.requests.limit_day)"
  end' 2>/dev/null || echo "  could not read /status"

echo
echo "Which fixture queries work for team $team"
report "next=1"                     "$(call "$base/fixtures?team=$team&next=1")"
report "season=$year"               "$(call "$base/fixtures?team=$team&season=$year")"
report "season=$year + date range"  "$(call "$base/fixtures?team=$team&season=$year&from=$today&to=$later")"
report "date range, no season"      "$(call "$base/fixtures?team=$team&from=$today&to=$later")"
report "last=1"                     "$(call "$base/fixtures?team=$team&last=1")"

echo
echo "Seasons your plan can see (first/last few):"
call "$base/leagues?team=$team" | jq -r '
  [.response[]?.seasons[]?.year] | unique | sort
  | if length == 0 then "  none reported" else "  " + (.[0:6]|map(tostring)|join(", ")) + (if length>6 then " … " + (.[-3:]|map(tostring)|join(", ")) else "" end) end' 2>/dev/null || echo "  could not read /leagues"
